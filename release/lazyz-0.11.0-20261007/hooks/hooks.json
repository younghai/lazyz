{
	"hooks": {
		"SessionStart": [
			{
				"matcher": "compact|clear",
				"hooks": [
					{
						"type": "process",
						"command": "node",
						"args": [
							"${ZCODE_PLUGIN_ROOT}/components/lsp/dist/cli.js",
							"hook",
							"session-start"
						],
						"timeoutMs": 5000,
						"statusMessage": "(LazyZ 0.11.0) Resetting LSP Context"
					}
				]
			},
			{
				"matcher": "compact|clear",
				"hooks": [
					{
						"type": "process",
						"command": "node",
						"args": [
							"${ZCODE_PLUGIN_ROOT}/components/git-bash/dist/cli.js",
							"hook",
							"session-start"
						],
						"timeoutMs": 5000,
						"statusMessage": "(LazyZ 0.11.0) Resetting Git Reminder"
					}
				]
			},
			{
				"hooks": [
					{
						"type": "process",
						"command": "node",
						"statusMessage": "(LazyZ 0.11.0) Checking Bootstrap State",
						"args": [
							"${ZCODE_PLUGIN_ROOT}/components/bootstrap/dist/cli.js",
							"hook",
							"session-start"
						],
						"timeoutMs": 30000
					}
				]
			},
			{
				"hooks": [
					{
						"type": "process",
						"command": "node",
						"statusMessage": "(LazyZ 0.11.0) Checking CodeGraph Bootstrap",
						"args": [
							"${ZCODE_PLUGIN_ROOT}/components/codegraph/dist/cli.js",
							"hook",
							"session-start"
						],
						"timeoutMs": 15000
					}
				]
			},
			{
				"hooks": [
					{
						"type": "process",
						"command": "node",
						"statusMessage": "(LazyZ 0.11.0) Loading Project Rules",
						"args": [
							"${ZCODE_PLUGIN_ROOT}/components/rules/dist/cli.js",
							"hook",
							"session-start"
						],
						"timeoutMs": 10000
					}
				]
			},
			{
				"hooks": [
					{
						"type": "process",
						"command": "node",
						"statusMessage": "(LazyZ 0.11.0) Recording Session Telemetry",
						"args": [
							"${ZCODE_PLUGIN_ROOT}/components/telemetry/dist/cli.js",
							"hook",
							"session-start"
						],
						"timeoutMs": 5000
					}
				]
			},
			{
				"hooks": [
					{
						"type": "process",
						"command": "node",
						"statusMessage": "(LazyZ 0.11.0) Resuming Work Status",
						"args": [
							"${ZCODE_PLUGIN_ROOT}/components/work-status/dist/cli.js",
							"hook",
							"session-start"
						],
						"timeoutMs": 10000
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "process",
						"command": "node",
						"statusMessage": "(LazyZ 0.11.0) Checking Ultrawork Trigger",
						"args": [
							"${ZCODE_PLUGIN_ROOT}/components/ultrawork/dist/cli.js",
							"hook",
							"user-prompt-submit"
						],
						"timeoutMs": 5000
					}
				]
			},
			{
				"hooks": [
					{
						"type": "process",
						"command": "node",
						"statusMessage": "(LazyZ 0.11.0) Checking Ulw-Loop Steering",
						"args": [
							"${ZCODE_PLUGIN_ROOT}/components/ulw-loop/dist/cli.js",
							"hook",
							"user-prompt-submit"
						],
						"timeoutMs": 5000
					}
				]
			},
			{
				"hooks": [
					{
						"type": "process",
						"command": "node",
						"statusMessage": "(LazyZ 0.11.0) Loading Project Rules",
						"args": [
							"${ZCODE_PLUGIN_ROOT}/components/rules/dist/cli.js",
							"hook",
							"user-prompt-submit"
						],
						"timeoutMs": 10000
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "^(Agent|Task)$",
				"hooks": [
					{
						"type": "process",
						"command": "node",
						"statusMessage": "(LazyZ 0.11.0) Reserving Executor Budget",
						"args": [
							"${ZCODE_PLUGIN_ROOT}/components/lazycodex-executor-verify/dist/cli.js",
							"hook",
							"pre-tool-use"
						],
						"timeoutMs": 10000
					}
				]
			},
			{
				"matcher": "^Bash$",
				"hooks": [
					{
						"type": "process",
						"command": "node",
						"statusMessage": "(LazyZ 0.11.0) Recommending Git Bash MCP",
						"args": [
							"${ZCODE_PLUGIN_ROOT}/components/git-bash/dist/cli.js",
							"hook",
							"pre-tool-use"
						],
						"timeoutMs": 5000
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "^(Edit|Write|ApplyPatch)$",
				"hooks": [
					{
						"type": "process",
						"command": "node",
						"statusMessage": "(LazyZ 0.11.0) Checking Comments",
						"args": [
							"${ZCODE_PLUGIN_ROOT}/components/comment-checker/dist/cli.js",
							"hook",
							"post-tool-use"
						],
						"timeoutMs": 5000
					}
				]
			},
			{
				"matcher": "^(Edit|Write|ApplyPatch)$",
				"hooks": [
					{
						"type": "process",
						"command": "node",
						"statusMessage": "(LazyZ 0.11.0) Checking LSP Diagnostics",
						"args": [
							"${ZCODE_PLUGIN_ROOT}/components/lsp/dist/cli.js",
							"hook",
							"post-tool-use"
						],
						"timeoutMs": 5000
					}
				]
			},
			{
				"matcher": "^(Edit|Write|ApplyPatch)$",
				"hooks": [
					{
						"type": "process",
						"command": "node",
						"statusMessage": "(LazyZ 0.11.0) Matching Project Rules",
						"args": [
							"${ZCODE_PLUGIN_ROOT}/components/rules/dist/cli.js",
							"hook",
							"post-tool-use"
						],
						"timeoutMs": 5000
					}
				]
			},
			{
				"matcher": "^(mcp__codegraph__.*)$",
				"hooks": [
					{
						"type": "process",
						"command": "node",
						"statusMessage": "(LazyZ 0.11.0) Checking CodeGraph Init Guidance",
						"args": [
							"${ZCODE_PLUGIN_ROOT}/components/codegraph/dist/cli.js",
							"hook",
							"post-tool-use"
						],
						"timeoutMs": 5000
					}
				]
			},
			{
				"matcher": "^(Agent|Task)$",
				"hooks": [
					{
						"type": "process",
						"command": "node",
						"statusMessage": "(LazyZ 0.11.0) Verifying Executor Evidence",
						"args": [
							"${ZCODE_PLUGIN_ROOT}/components/lazycodex-executor-verify/dist/cli.js",
							"hook",
							"post-tool-use"
						],
						"timeoutMs": 5000
					}
				]
			}
		],
		"PostToolUseFailure": [
			{
				"matcher": "^(Agent|Task)$",
				"hooks": [
					{
						"type": "process",
						"command": "node",
						"statusMessage": "(LazyZ 0.11.0) Recording Executor Failure",
						"args": [
							"${ZCODE_PLUGIN_ROOT}/components/lazycodex-executor-verify/dist/cli.js",
							"hook",
							"post-tool-use-failure"
						],
						"timeoutMs": 10000
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "process",
						"command": "node",
						"statusMessage": "(LazyZ 0.11.0) Checking Executor Tasks",
						"args": [
							"${ZCODE_PLUGIN_ROOT}/components/lazycodex-executor-verify/dist/cli.js",
							"hook",
							"stop"
						],
						"timeoutMs": 10000
					}
				]
			},
			{
				"hooks": [
					{
						"type": "process",
						"command": "node",
						"statusMessage": "(LazyZ 0.11.0) Checking Start-Work Continuation",
						"args": [
							"${ZCODE_PLUGIN_ROOT}/components/start-work-continuation/dist/cli.js",
							"hook",
							"stop"
						],
						"timeoutMs": 10000
					}
				]
			}
		]
	}
}
